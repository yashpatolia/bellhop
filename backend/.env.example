# Names only. Copy to .env (git-ignored) and fill in; never commit values.
BELLHOP_MEMORY=          # local | moss
BELLHOP_STORE=           # memory | spacetimedb
BELLHOP_SEED_DEMO=       # 1 loads demo data
BELLHOP_STDB_URL=        # http(s) SpacetimeDB address
BELLHOP_STDB_DB=
BELLHOP_STDB_TOKEN=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
BELLHOP_GUARDS=          # 0 disables adapter timeout guards
BELLHOP_ROBOT_URL=       # http(s) robot gateway
BELLHOP_CONTENT=         # local | wikipedia | apify
APIFY_TOKEN=
BELLHOP_API_KEY=         # set to require X-API-Key on all routes except /health
BELLHOP_CORS_ORIGINS=    # comma-separated origins, default *
BELLHOP_ALLOW_NEW_ROBOTS=  # 0 = PUT /robots/{id} only for known robots
BELLHOP_SEED_FILE=       # scenario JSON; scenarios/empty.json starts with nothing
BELLHOP_LEARNING=        # rule | claude (claude needs: uv sync --extra claude)
BELLHOP_EXTRACTOR_MODEL= # Claude model for fact extraction
BELLHOP_REFINER=         # rule | claude (staff note tidy)
BELLHOP_REFINER_MODEL=   # Claude model for the note tidy
ANTHROPIC_API_KEY=       # needed when either of the two above is claude
BELLHOP_AGENT_SEED=      # Fetch.ai agent only: a long secret phrase
BELLHOP_AGENT_PORT=      # Fetch.ai agent only, default 8001
BELLHOP_AGENT_ALLOWED_SENDERS=  # Fetch.ai agent only: comma-separated agent addresses
