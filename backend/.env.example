# Names only. Copy to .env (git-ignored) and fill in; never commit values.
BELLHOP_MEMORY=          # local | moss
BELLHOP_STORE=           # memory | spacetimedb
BELLHOP_SEED_DEMO=       # 1 loads demo data
BELLHOP_STDB_URL=        # http(s) SpacetimeDB address
BELLHOP_STDB_DB=
BELLHOP_STDB_TOKEN=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
BELLHOP_GUARDS=          # 0 disables adapter timeout guards
BELLHOP_ROBOT_URL=       # http(s) robot gateway
BELLHOP_CONTENT=         # local | wikipedia | apify
APIFY_TOKEN=
BELLHOP_API_KEY=         # set to require X-API-Key on all routes except /health
BELLHOP_CORS_ORIGINS=    # comma-separated origins, default *
BELLHOP_ALLOW_NEW_ROBOTS=  # 0 = PUT /robots/{id} only for known robots
