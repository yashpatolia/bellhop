            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Assigned To"
          },
          "robot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Robot Id"
