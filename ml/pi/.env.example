# Copy to .env next to this file. Never commit .env.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# Optional: advisory Jev triage/tone. Leave empty to disable; never commit a real key.
TYPESAFE_API_KEY=
# Optional override; every failure falls back without delaying speech or navigation.
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_S=1.5

# Mac: http://127.0.0.1:8000   Pi: http://<laptop-tailscale-ip>:8000
BELLHOP_API=http://127.0.0.1:8000
# Time budgets are separate: the Pi drive server is local; the backend crosses Tailscale/WSL.
# BELLHOP_LOCAL_HTTP_TIMEOUT_S=2.0
# BELLHOP_BACKEND_HTTP_TIMEOUT_S=5.0
# Only if the backend sets BELLHOP_API_KEY
BELLHOP_API_KEY=
ROBOT_ID=robot_1
# JSON mapping from physical ArUco IDs to logical backend room names. Numeric targets address
# their matching marker directly, so leave this empty unless your backend uses logical names.
BELLHOP_MARKER_ROOMS={}
BELLHOP_HOME_ROOM=lobby
# If the rover reverses when commanded forward, set this to -1. It reverses both motor sides,
# preserving steering and the PS2 controller's logical directions.
# BELLHOP_MOTOR_FORWARD_SIGN=-1
# Safe camera-head positions to sweep, only while stationary and a requested marker is missing.
# Tune these after running `python -m rover.drive --head-test`; wheel motors remain stopped.
# Freenove's proven obstacle-avoidance sweep: pan 30, 90, 150. Pan end-stops are prohibited
# because the stock client's +10-degree calibration can overdrive a servo at 0 or 180.
# BELLHOP_HEAD_SCAN_PANS=30,90,150
# BELLHOP_HEAD_SCAN_TILTS=80,90,110
# BELLHOP_HEAD_SCAN_DWELL_S=0.6
# BELLHOP_HEAD_RECENTER_SETTLE_S=0.3
# Marker search goes beyond the initial camera view: stopped head sweep, in-place turn, then a
# short ultrasonic-guarded forward step. It has no map/odometry guarantee and stops after 45 s.
# BELLHOP_ACTIVE_MARKER_SEARCH=1
# BELLHOP_SEARCH_TURN_DUTY=900
# BELLHOP_SEARCH_TURN_S=0.35
# BELLHOP_SEARCH_TURNS_PER_LAP=8
# BELLHOP_SEARCH_ADVANCE_S=0.35
# BELLHOP_SEARCH_MAX_S=45
# Optional manual backup controller. Launch rover.drive with --controller to enable it.
# Most PS2 USB/Bluetooth adapters expose /dev/input/js0. Hold the configured deadman button to move.
# BELLHOP_MANUAL_DEVICE=/dev/input/js0
# BELLHOP_MANUAL_DEADMAN_BUTTON=4
# BELLHOP_MANUAL_FORWARD_AXIS=1
# BELLHOP_MANUAL_TURN_AXIS=0
# rover.drive's server on this Pi (same machine as rover.speech)
PI_SERVER_URL=http://127.0.0.1:8080
# Pi: part of the USB device names from `uv run python -m sounddevice` (the default is HDMI)
MIC_NAME=
SPEAKER_NAME=
# Keep the newest audio if a cloud STT send or the Pi briefly falls behind. Microphone blocks are
# 32 ms; Flux pairs them into 64 ms messages. Do not make either queue unbounded.
# MIC_QUEUE_BLOCKS=64
# FLUX_SEND_QUEUE_BLOCKS=64
# Pi, only if not the defaults: PCB version printed on the car board (battery formula), Freenove's repo
# FREENOVE_PCB_VERSION=2
# FREENOVE_DIR=/home/pi/Freenove_4WD_Smart_Car_Kit_for_Raspberry_Pi/Code/Server
