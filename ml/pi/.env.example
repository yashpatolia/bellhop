# Copy to .env next to this file. Never commit .env.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# Optional: Jev triage runs only when this is set
TYPESAFE_API_KEY=

# Mac: http://127.0.0.1:8000   Pi: http://<laptop-tailscale-ip>:8000
BELLHOP_API=http://127.0.0.1:8000
# Only if the backend sets BELLHOP_API_KEY
BELLHOP_API_KEY=
ROBOT_ID=robot_1
# rover.drive's server on this Pi (same machine as rover.speech)
PI_SERVER_URL=http://127.0.0.1:8080
# Pi: part of the USB device names from `uv run python -m sounddevice` (the default is HDMI)
MIC_NAME=
SPEAKER_NAME=
# Pi, only if not the defaults: PCB version printed on the car board (battery formula), Freenove's repo
# FREENOVE_PCB_VERSION=2
# FREENOVE_DIR=/home/pi/Freenove_4WD_Smart_Car_Kit_for_Raspberry_Pi/Code/Server
